{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandipulse.local/schemas/web-export/v2/honest_results.schema.json",
  "title": "Held-out model result export",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["model", "test_mae", "ships"],
    "properties": {
      "model": { "type": "string", "minLength": 1 },
      "test_mae": { "type": "number", "minimum": 0 },
      "ships": { "type": "boolean" }
    }
  }
}
