{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mandipulse.local/schemas/web-export/v2/forecasts.schema.json",
  "title": "Forecast export",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "market_id",
      "mandi_id",
      "mandi",
      "as_of_date",
      "forecast_price_inr_qtl",
      "lower_bound_inr_qtl",
      "upper_bound_inr_qtl",
      "confidence_level",
      "risk_level"
    ],
    "properties": {
      "market_id": { "type": "integer" },
      "mandi_id": { "type": "string", "minLength": 1 },
      "mandi": { "type": "string", "minLength": 1 },
      "as_of_date": { "type": "string", "format": "date" },
      "forecast_price_inr_qtl": { "type": "number" },
      "lower_bound_inr_qtl": { "type": "number" },
      "upper_bound_inr_qtl": { "type": "number" },
      "confidence_level": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
      "risk_level": { "enum": ["low", "medium", "high"] }
    }
  }
}
